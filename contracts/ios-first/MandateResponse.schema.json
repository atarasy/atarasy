{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MandateResponse",
  "description": "Pinned client contract. Signatures, actor scope and semantic constraints require server verification; safe integers and required config signature are client constraints.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "household": {
      "type": "string",
      "minLength": 1
    },
    "ceiling_out_of_network": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ceiling_daily": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cooling_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "co_signers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lapses_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "household",
    "ceiling_out_of_network",
    "ceiling_daily",
    "cooling_seconds",
    "co_signers",
    "lapses_at",
    "version"
  ],
  "additionalProperties": false
}
