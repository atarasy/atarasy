{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeMandateRequest",
  "description": "Pinned native-client subset; schema validation is not authority verification or complete server conformance.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "household": {
      "type": "string",
      "minLength": 1
    },
    "ceiling_out_of_network": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ceiling_daily": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cooling_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "co_signers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lapses_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "assertions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "authenticator_data": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "client_data_json": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "signature": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "authenticator_data",
          "client_data_json",
          "signature"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "household",
    "ceiling_out_of_network",
    "co_signers",
    "lapses_at",
    "version",
    "assertions"
  ],
  "additionalProperties": false
}
