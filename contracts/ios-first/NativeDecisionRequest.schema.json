{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeDecisionRequest",
  "description": "Pinned native-client subset; schema validation is not authority verification or complete server conformance.",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "valence": {
            "type": "string",
            "enum": [
              "kept",
              "returned"
            ]
          },
          "kept_as": {
            "type": "string",
            "enum": [
              "self",
              "gift",
              "order"
            ]
          },
          "lineage": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "candidate",
          "valence"
        ],
        "additionalProperties": false
      }
    },
    "assertion": {
      "type": "object",
      "properties": {
        "authenticator_data": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "client_data_json": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "signature": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "authenticator_data",
        "client_data_json",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "decisions",
    "assertion"
  ],
  "additionalProperties": false
}
