{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeSettleRequest",
  "description": "Pinned native-client subset; schema validation is not authority verification or complete server conformance.",
  "type": "object",
  "properties": {
    "assertion": {
      "type": "object",
      "properties": {
        "authenticator_data": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "client_data_json": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "signature": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "authenticator_data",
        "client_data_json",
        "signature"
      ],
      "additionalProperties": false
    },
    "disputed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
