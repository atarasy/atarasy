{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfferCreationRequest",
  "description": "Pinned client contract. Signatures, actor scope and semantic constraints require server verification; safe integers and required config signature are client constraints.",
  "type": "object",
  "properties": {
    "binding": {
      "enum": [
        "physical",
        "digital"
      ]
    },
    "household": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "gift",
        "replenish",
        "trial",
        "ceremonial",
        "assortment"
      ]
    },
    "config_version": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mandate": {
      "type": "string",
      "minLength": 1
    },
    "price_band": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "giver": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "predicted_conversion": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "is_exploration": {
            "type": "boolean"
          },
          "given_by": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "product",
          "quantity",
          "is_exploration"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "binding",
    "household",
    "purpose",
    "config_version",
    "expires_at",
    "mandate",
    "candidates"
  ],
  "additionalProperties": false
}
